# Nilai NODE_ENV, PORT, dan DATABASE_URL dipakai saat API dijalankan tanpa Docker.
NODE_ENV=development
PORT=3000
APP_PORT=8080
APP_ORIGIN=https://inventaris.example.com
POSTGRES_DB=zaina
POSTGRES_USER=zaina
POSTGRES_PASSWORD=replace-with-url-safe-random-password
DATABASE_URL=postgresql://zaina:replace-with-url-safe-random-password@localhost:5432/zaina
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=toko
ADMIN_PASSWORD=replace-with-a-strong-password
STORE_NAME=Toko Zaina
STORE_TIMEZONE=Asia/Jakarta
SEED_DEMO_DATA=false
