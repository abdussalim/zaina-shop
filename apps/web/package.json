    "@zaina/shared": "0.1.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
