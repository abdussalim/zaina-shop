{
  "name": "@zaina/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --outfile=../web/dist/_worker.js --format=esm --target=es2022 --conditions=workerd --external:node:*",
    "dev": "wrangler pages dev ../web/dist --port=8788",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zaina/shared": "workspace:*",
    "hono": "^4.6.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "esbuild": "^0.24.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
