# ==============================================================================
# Toko Zaina - CV Edge Agent Configuration
# Salin file ini menjadi `.env` lalu isi nilai sesuai PC Intel & akun Cloudflare.
# JANGAN PERNAH commit file `.env` ke Git!
# ==============================================================================

# URL dasar API Cloudflare Workers milik zaina-shop (tanpa garis miring di akhir)
CLOUDFLARE_API_BASE=https://api.zaina-shop.example.com

# Kunci rahasia bersama antara PC Intel dan Cloudflare Worker (header X-Monitor-Agent-Key)
MONITOR_AGENT_KEY=replace-with-strong-shared-secret

# URL RTSP kamera toko (gunakan format rtsp://user:password@IP:PORT/path)
# Kosongkan salah satu jika hanya menggunakan 1 kamera.
CAM1_RTSP_URL=rtsp://user:password@192.168.1.3:554/ch0_0.264
CAM2_RTSP_URL=rtsp://user:password@192.168.1.8:554/streamtype=0

# Perangkat OpenVINO: GPU (Intel iGPU /dev/dri) atau CPU (otomatis fallback ke CPU jika GPU gagal)
OPENVINO_DEVICE=GPU

# Opsional: path manual ke file .xml model OpenVINO (kosongkan untuk auto-detect INT8 > FP16 > FP32 di folder models/)
OPENVINO_MODEL_PATH=

# Port server MJPEG lokal untuk live stream bebas lag (isi 0 untuk menonaktifkan)
MJPEG_PORT=8090
MJPEG_HOST=0.0.0.0

# Aktifkan unggah snapshot JPEG berkala ke Cloudflare R2 sebagai fallback saat tunnel offline (true/false)
UPLOAD_FRAMES_TO_CLOUD=true

# Interval minimum unggah snapshot ke Cloudflare R2 dalam detik (disarankan >= 1.2 agar hemat kuota gratis R2)
FRAME_UPLOAD_INTERVAL_SEC=1.2

# Interval heartbeat & sinkronisasi kontrol dari Cloudflare dalam detik
HEARTBEAT_INTERVAL_SEC=5.0

# Target anggaran waktu per frame dalam detik (0.1 = target ~10 FPS untuk watch/serving display)
INFERENCE_BUDGET_SEC=0.1

# Kualitas JPEG (1-100) untuk live MJPEG dan upload R2
JPEG_QUALITY=60
CLOUD_JPEG_QUALITY=45

# Ambang kepercayaan deteksi orang (0.1 - 0.95)
CAM1_THRESHOLD=0.5
CAM2_THRESHOLD=0.45

# Region of Interest (ROI) dalam rasio normalisasi x1,y1,x2,y2 (0.0 sampai 1.0)
CAM1_ROI=0.0,0.0,0.8,1.0
CAM2_ROI=0.3,0.4,1.0,1.0

# Opsional: Token Cloudflare Tunnel jika menjalankan service `cloudflared` via Docker Compose
# CLOUDFLARE_TUNNEL_TOKEN=
