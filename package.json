{
  "name": "toko-zaina-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @zaina/shared build && pnpm --filter @zaina/web build && pnpm --filter @zaina/api build",
    "dev": "concurrently -n shared,web,api -c yellow,cyan,green \"pnpm --filter @zaina/shared dev\" \"pnpm --filter @zaina/web dev\" \"pnpm --filter @zaina/api dev\"",
    "dev:web": "pnpm --filter @zaina/web dev",
    "dev:api": "pnpm --filter @zaina/api dev",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "oxlint --deny-warnings --react-plugin --vitest-plugin --jsx-a11y-plugin --import-plugin .",
    "deploy": "wrangler pages deploy apps/web/dist --project-name zaina-shop"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "oxlint": "^1.77.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.165.0"
  }
}
